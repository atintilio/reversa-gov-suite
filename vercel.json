{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "outputDirectory": ".",
  "functions": {
    "api/v1/[...route].js": {
      "maxDuration": 60,
      "includeFiles": "assets/**"
    },
    "api/v1/rota.js": {
      "maxDuration": 60,
      "includeFiles": "assets/**"
    },
    "api/cron-semanal.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/([^/]+)/(.+)",
      "destination": "/api/v1/rota?rvpath=$1/$2"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-semanal",
      "schedule": "0 23 * * 3"
    }
  ]
}
